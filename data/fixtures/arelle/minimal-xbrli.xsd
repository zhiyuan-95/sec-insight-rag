<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    targetNamespace="http://www.xbrl.org/2003/instance"
    elementFormDefault="qualified">
  <xs:attribute name="periodType" type="xs:string"/>
  <xs:attribute name="balance" type="xs:string"/>
  <xs:element name="item" abstract="true"/>
  <xs:complexType name="tupleType">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:element name="tuple" type="xbrli:tupleType" abstract="true"/>
  <xs:simpleType name="monetaryItemType">
    <xs:restriction base="xs:decimal"/>
  </xs:simpleType>
</xs:schema>
